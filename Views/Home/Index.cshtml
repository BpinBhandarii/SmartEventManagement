@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero -->
<section class="hero-section">
    <h1>Smart Event Management</h1>
    <p class="hero-sub">Organise, register, and experience events like never before.</p>
    <div class="hero-btn-group">
        <a asp-controller="Account" asp-action="Register" class="hero-btn-primary">
            <i class="fa fa-rocket me-2"></i>Get Started
        </a>
        <a asp-controller="Account" asp-action="Login" class="hero-btn-outline">
            <i class="fa fa-right-to-bracket me-2"></i>Login
        </a>
    </div>
</section>

<!-- Features -->
<section class="features-section">
    <div class="container">
        <div class="text-center mb-4">
            <h4 style="font-weight:700">Everything you need</h4>
            <p class="text-muted small">Simple tools for organisers and attendees</p>
        </div>
        <div class="row g-3 justify-content-center">
            <div class="col-md-4 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <h5>Easy Event Creation</h5>
                    <p>Create and manage events in minutes with capacity control and category tagging.</p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-ticket"></i></div>
                    <h5>Seamless Registration</h5>
                    <p>Attendees can browse, filter, and register for events instantly with live capacity checks.</p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-bell"></i></div>
                    <h5>Real-time Notifications</h5>
                    <p>Stay updated with instant notifications for approvals, updates, and reminders.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="landing-footer">
    &copy; @DateTime.Now.Year <span>Smart Event Management</span> &mdash; <span>Wholesome Coders</span>
</footer>
