@model List<SmartEventManagement.Models.Event>
@{
    ViewData["Title"] = "Manage Events";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex">
    <partial name="_AdminSidebar" />
    <div class="main-content flex-grow-1">
        <div class="top-bar">
            <button class="btn btn-sm btn-light d-md-none me-2" id="sidebar-toggle"><i class="fa fa-bars"></i></button>
            <h5 class="page-title"><i class="fa fa-calendar me-2 text-primary"></i>All Events</h5>
            <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill">@Model.Count Events</span>
        </div>
        <div class="content-area">
            <div class="table-card">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Organiser</th>
                            <th>Date</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th>Feedback</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-600 small">@ev.Title</div>
                                    <div class="small text-muted">@ev.Category • @ev.Location</div>
                                </td>
                                <td class="small">@ev.Organiser?.FullName</td>
                                <td class="small text-muted">@ev.Date.ToString("dd MMM yyyy")</td>
                                <td class="small">@ev.Capacity</td>
                                <td>
                                    <span class="badge rounded-pill
                                        @(ev.Status == "Approved" ? "badge-status-approved" :
                                          ev.Status == "Pending"  ? "badge-status-pending"  :
                                          ev.Status == "Cancelled"? "badge-status-cancelled": "badge-status-completed")">
                                        @ev.Status
                                    </span>
                                </td>
                                <td>
                                    @if (ev.Feedbacks.Any())
                                    {
                                        <button class="btn btn-sm btn-outline-warning"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#fb-@ev.Id"
                                                aria-expanded="false">
                                            <i class="fa fa-star me-1"></i>@ev.Feedbacks.Count
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (ev.Status == "Pending")
                                    {
                                        <form asp-action="ApproveEvent" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@ev.Id" />
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="fa fa-check me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form asp-action="RejectEvent" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@ev.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger me-1"
                                                    onclick="return confirm('Reject event \'@ev.Title\'?')">
                                                <i class="fa fa-xmark me-1"></i>Reject
                                            </button>
                                        </form>
                                    }
                                    @if (ev.Status == "Approved" || ev.Status == "Rejected")
                                    {
                                        <form asp-action="MarkEventPending" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@ev.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary me-1"
                                                    onclick="return confirm('Move \'@ev.Title\' back to Pending?')">
                                                <i class="fa fa-rotate-left me-1"></i>Pending
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="DeleteEvent" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="eventId" value="@ev.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete event \'@ev.Title\'? This cannot be undone.')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            @if (ev.Feedbacks.Any())
                            {
                                <tr class="collapse" id="fb-@ev.Id">
                                    <td colspan="7" class="p-0">
                                        <div class="px-4 py-3" style="background:var(--bg-light,#f8f9fb);border-top:1px solid var(--border-color,#e9ecef)">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <i class="fa fa-star text-warning"></i>
                                                <span class="fw-600 small">Feedback for "@ev.Title"</span>
                                                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill ms-1">@ev.Feedbacks.Count review@(ev.Feedbacks.Count == 1 ? "" : "s")</span>
                                                @{
                                                    var avg = ev.Feedbacks.Average(f => f.Rating);
                                                }
                                                <span class="small text-muted ms-2">Avg: <strong>@avg.ToString("0.0")</strong>/5</span>
                                            </div>
                                            <table class="table table-sm table-borderless mb-0">
                                                <thead class="small text-muted">
                                                    <tr>
                                                        <th>Attendee</th>
                                                        <th>Rating</th>
                                                        <th>Comment</th>
                                                        <th>Date</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var fb in ev.Feedbacks.OrderByDescending(f => f.SubmittedAt))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="fw-600 small">@fb.Attendee?.FullName</div>
                                                                <div class="text-muted" style="font-size:0.72rem">@fb.Attendee?.Email</div>
                                                            </td>
                                                            <td>
                                                                <span class="text-warning">
                                                                    @for (int i = 1; i <= 5; i++)
                                                                    {
                                                                        <i class="fa fa-star @(i <= fb.Rating ? "" : "text-muted opacity-25")"></i>
                                                                    }
                                                                </span>
                                                                <span class="text-muted small ms-1">@fb.Rating/5</span>
                                                            </td>
                                                            <td class="small text-muted" style="max-width:280px">
                                                                @(fb.Comment?.Length > 120 ? fb.Comment[..120] + "…" : fb.Comment)
                                                            </td>
                                                            <td class="small text-muted text-nowrap">@fb.SubmittedAt.ToString("dd MMM yyyy")</td>
                                                            <td>
                                                                <form asp-action="DeleteFeedback" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="feedbackId" value="@fb.Id" />
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                            onclick="return confirm('Delete this feedback? This cannot be undone.')">
                                                                        <i class="fa fa-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>initSignalR('@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value');</script>
}
