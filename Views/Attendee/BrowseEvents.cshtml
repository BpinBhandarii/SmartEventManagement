@model List<SmartEventManagement.Models.Event>
@{
    ViewData["Title"] = "Browse Events";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var registeredIds = ViewBag.RegisteredEventIds as List<int> ?? new List<int>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="d-flex">
    <partial name="_AttendeeSidebar" />
    <div class="main-content flex-grow-1">
        <div class="top-bar">
            <button class="btn btn-sm btn-light d-md-none me-2" id="sidebar-toggle"><i class="fa fa-bars"></i></button>
            <h5 class="page-title"><i class="fa fa-magnifying-glass me-2 text-primary"></i>Browse Events</h5>
        </div>
        <div class="content-area">
            <!-- Search & Filter -->
            <form asp-action="BrowseEvents" method="get" class="card p-3 mb-4">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <div class="input-icon-wrapper">
                            <i class="fa fa-search input-icon"></i>
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search events..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="category" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var cat in categories)
                            {
                                if ((string?)ViewBag.Category == cat)
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="dateFilter" class="form-select">
                            <option value="">Upcoming</option>
                            @{ var df = (string?)ViewBag.DateFilter; }
                            @if (df == "today") { <option value="today" selected>Today</option> } else { <option value="today">Today</option> }
                            @if (df == "week")  { <option value="week" selected>This Week</option> } else { <option value="week">This Week</option> }
                            @if (df == "month") { <option value="month" selected>This Month</option> } else { <option value="month">This Month</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-gradient w-100">
                            <i class="fa fa-filter me-1"></i>Filter
                        </button>
                    </div>
                </div>
            </form>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa fa-calendar-xmark fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No events found</h5>
                    <p class="text-muted small">Try adjusting your filters.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var ev in Model)
                    {
                        var isRegistered = registeredIds.Contains(ev.Id);
                        var regCount = ev.Registrations.Count(r => !r.Cancelled);
                        var pct = ev.Capacity > 0 ? (int)((double)regCount / ev.Capacity * 100) : 0;
                        var isFull = regCount >= ev.Capacity;

                        <div class="col-md-6 col-lg-4">
                            <div class="event-card">
                                <div class="event-card-banner">
                                    @(ev.Category == "Tech" ? "💻" :
                                      ev.Category == "Music" ? "🎵" :
                                      ev.Category == "Sports" ? "⚽" :
                                      ev.Category == "Arts" ? "🎨" :
                                      ev.Category == "Business" ? "💼" :
                                      ev.Category == "Education" ? "📚" : "🎉")
                                </div>
                                <div class="event-card-body">
                                    <span class="category-badge">@ev.Category</span>
                                    <h6>@ev.Title</h6>
                                    <div class="event-card-meta"><i class="fa fa-calendar"></i> @ev.Date.ToString("dd MMM yyyy")</div>
                                    <div class="event-card-meta"><i class="fa fa-clock"></i> @ev.Time.ToString(@"hh\:mm")</div>
                                    <div class="event-card-meta"><i class="fa fa-location-dot"></i> @ev.Location</div>
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                            <span><i class="fa fa-users me-1"></i>@regCount / @ev.Capacity</span>
                                            <span>@pct%</span>
                                        </div>
                                        <div class="capacity-bar">
                                            <div class="progress">
                                                <div class="progress-bar" style="width:@pct%"
                                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="event-card-footer">
                                    <div class="d-flex gap-2">
                                        <a asp-action="EventDetails" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                            <i class="fa fa-eye me-1"></i>Details
                                        </a>
                                        @if (isRegistered)
                                        {
                                            <button class="btn btn-sm btn-success flex-grow-1" disabled>
                                                <i class="fa fa-check me-1"></i>Registered
                                            </button>
                                        }
                                        else if (isFull)
                                        {
                                            <button class="btn btn-sm btn-secondary flex-grow-1" disabled>Full</button>
                                        }
                                        else
                                        {
                                            <form asp-action="Register" method="post" class="flex-grow-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="eventId" value="@ev.Id" />
                                                <button type="submit" class="btn btn-gradient btn-sm w-100">
                                                    <i class="fa fa-ticket me-1"></i>Register
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
