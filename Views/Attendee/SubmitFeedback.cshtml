@model SmartEventManagement.ViewModels.FeedbackViewModel
@{
    ViewData["Title"] = "Submit Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex">
    <partial name="_AttendeeSidebar" />
    <div class="main-content flex-grow-1">
        <div class="top-bar">
            <button class="btn btn-sm btn-light d-md-none me-2" id="sidebar-toggle"><i class="fa fa-bars"></i></button>
            <h5 class="page-title"><i class="fa fa-star me-2 text-primary"></i>Submit Feedback</h5>
        </div>
        <div class="content-area">
            <div class="card p-4" style="max-width:600px;margin:0 auto">
                <h5 class="fw-700 mb-1">@Model.EventTitle</h5>
                <p class="text-muted small mb-4">Share your experience to help organisers improve future events.</p>

                <form asp-action="SubmitFeedback" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="EventTitle" />

                    <asp-validation-summary model-only="true" class="alert alert-danger rounded-3 mb-3"></asp-validation-summary>

                    <!-- Star Rating -->
                    <div class="mb-4">
                        <label class="form-label fw-600">Your Rating</label>
                        <div class="d-flex gap-2" id="star-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button type="button" class="btn btn-link p-0 star-btn" data-value="@i"
                                        style="font-size:2.2rem;color:#ddd;transition:color 0.1s;text-decoration:none">
                                    <i class="fa fa-star"></i>
                                </button>
                            }
                        </div>
                        <input type="hidden" asp-for="Rating" id="ratingInput" />
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-floating">
                            <textarea asp-for="Comment" class="form-control" placeholder="Write your review..."
                                      style="height:150px"></textarea>
                            <label asp-for="Comment">Write your review (min 10 characters)</label>
                        </div>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gradient px-4">
                            <i class="fa fa-paper-plane me-2"></i>Submit Feedback
                        </button>
                        <a asp-action="MyRegistrations" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(function(){
    var stars = document.querySelectorAll('.star-btn');
    var ratingInput = document.getElementById('ratingInput');

    function setStars(val) {
        stars.forEach(function(s, idx) {
            s.querySelector('i').style.color = idx < val ? '#ffc107' : '#ddd';
        });
        ratingInput.value = val;
    }

    stars.forEach(function(btn) {
        btn.addEventListener('click', function() {
            setStars(parseInt(btn.getAttribute('data-value')));
        });
        btn.addEventListener('mouseenter', function() {
            stars.forEach(function(s, idx) {
                s.querySelector('i').style.color = idx < parseInt(btn.getAttribute('data-value')) ? '#ffc107' : '#ddd';
            });
        });
        btn.addEventListener('mouseleave', function() {
            setStars(parseInt(ratingInput.value) || 0);
        });
    });
})();
</script>
}
