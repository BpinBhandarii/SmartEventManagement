@model SmartEventManagement.ViewModels.AttendeeDashboardViewModel
@{
    ViewData["Title"] = "Attendee Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex">
    <partial name="_AttendeeSidebar" />
    <div class="main-content flex-grow-1">
        <div class="top-bar">
            <button class="btn btn-sm btn-light d-md-none me-2" id="sidebar-toggle"><i class="fa fa-bars"></i></button>
            <h5 class="page-title"><i class="fa fa-gauge me-2 text-primary"></i>Dashboard</h5>
            <a asp-action="BrowseEvents" class="btn btn-gradient btn-sm">
                <i class="fa fa-magnifying-glass me-1"></i>Browse Events
            </a>
        </div>
        <div class="content-area">
            <!-- Welcome -->
            <div class="welcome-banner mb-4">
                <div class="avatar-circle"><i class="fa fa-user"></i></div>
                <div>
                    <h4>Welcome back, @Model.AttendeeName! 👋</h4>
                    <p>Discover events, register, and track your attendance here.</p>
                </div>
            </div>

            <!-- Stats -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon purple"><i class="fa fa-bookmark"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@Model.RegisteredEvents</div>
                            <div class="stat-label">Registered Events</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fa fa-circle-check"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@Model.AttendedEvents</div>
                            <div class="stat-label">Attended Events</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon orange"><i class="fa fa-star"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@Model.PendingFeedback</div>
                            <div class="stat-label">Pending Feedback</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recommended Events -->
            @if (Model.RecommendedEvents.Any())
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="section-header mb-0"><i class="fa fa-star me-2 text-primary"></i>Recommended for You</h5>
                        <a asp-action="Recommendations" class="btn btn-sm btn-outline-primary">See All</a>
                    </div>
                    <div class="row g-3">
                        @foreach (var ev in Model.RecommendedEvents)
                        {
                            <div class="col-md-6 col-lg-3">
                                <div class="event-card">
                                    <div class="event-card-banner">
                                        @(ev.Category == "Tech" ? "💻" :
                                          ev.Category == "Music" ? "🎵" :
                                          ev.Category == "Sports" ? "⚽" :
                                          ev.Category == "Arts" ? "🎨" :
                                          ev.Category == "Business" ? "💼" :
                                          ev.Category == "Education" ? "📚" : "🎉")
                                    </div>
                                    <div class="event-card-body">
                                        <span class="category-badge">@ev.Category</span>
                                        <h6>@ev.Title</h6>
                                        <div class="event-card-meta">
                                            <i class="fa fa-calendar"></i> @ev.Date.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="event-card-meta">
                                            <i class="fa fa-location-dot"></i> @ev.Location
                                        </div>
                                    </div>
                                    <div class="event-card-footer">
                                        <a asp-action="EventDetails" asp-route-id="@ev.Id" class="btn btn-gradient btn-sm w-100">
                                            <i class="fa fa-ticket me-1"></i>Register
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Recent Registrations -->
            @if (Model.MyRegistrations.Any())
            {
                <div class="table-card">
                    <div class="d-flex align-items-center justify-content-between px-3 pt-3 pb-2">
                        <span class="section-header"><i class="fa fa-bookmark me-2 text-primary"></i>Recent Registrations</span>
                        <a asp-action="MyRegistrations" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <table class="table">
                        <thead><tr><th>Event</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var reg in Model.MyRegistrations)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-600 small">@reg.Event?.Title</div>
                                        <div class="text-muted" style="font-size:0.75rem">@reg.Event?.Location</div>
                                    </td>
                                    <td class="small text-muted">@reg.Event?.Date.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge badge-pill @(reg.Cancelled ? "badge-status-cancelled" : "badge-status-approved")">
                                            @(reg.Cancelled ? "Cancelled" : "Active")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
initSignalR('@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value');
</script>
}
