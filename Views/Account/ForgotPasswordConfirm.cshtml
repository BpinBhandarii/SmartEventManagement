@model string
@{
    ViewData["Title"] = "Reset Link";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var resetLink = ViewBag.ResetLink as string;
    var emailNotFound = ViewBag.EmailNotFound == true;
}

<div class="auth-page">
    <div class="auth-card" style="max-width:520px">
        @if (emailNotFound)
        {
            <div class="auth-icon" style="background:linear-gradient(135deg,#f97316,#ea580c)">
                <i class="fa-solid fa-circle-question"></i>
            </div>
            <h2>Email Not Found</h2>
            <p class="auth-subtitle">No account is registered with <strong>@Model</strong>. Please check the address or create a new account.</p>
            <a asp-action="Register" class="btn btn-gradient w-100 py-2 mb-3">
                <i class="fa fa-user-plus me-2"></i>Create Account
            </a>
        }
        else if (!string.IsNullOrEmpty(resetLink))
        {
            <div class="auth-icon" style="background:linear-gradient(135deg,#22c55e,#16a34a)">
                <i class="fa-solid fa-link"></i>
            </div>
            <h2>Reset Link Ready</h2>
            <p class="auth-subtitle">A password reset link has been generated for <strong>@Model</strong>. Copy and open it in your browser.</p>

            <div class="mb-4" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px">
                <div class="d-flex align-items-start gap-2">
                    <i class="fa fa-link text-success mt-1 flex-shrink-0"></i>
                    <div class="flex-grow-1" style="min-width:0">
                        <div class="small text-muted mb-1">Your reset link:</div>
                        <div id="reset-link-text" style="word-break:break-all;font-size:0.75rem;color:#166534;font-family:monospace">@resetLink</div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-success w-100 mt-2" onclick="copyLink()">
                    <i class="fa fa-copy me-1"></i><span id="copy-label">Copy Link</span>
                </button>
            </div>

            <a href="@resetLink" class="btn btn-gradient w-100 py-2 mb-3">
                <i class="fa fa-key me-2"></i>Open Reset Page Now
            </a>

            <div class="alert alert-warning py-2 px-3 rounded-3 small">
                <i class="fa fa-triangle-exclamation me-1"></i>
                This link expires after use. Keep it private.
            </div>
        }

        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            <a asp-action="Login" class="fw-600"><i class="fa fa-arrow-left me-1"></i>Back to Sign In</a>
        </p>
    </div>
</div>

@section Scripts {
<script>
function copyLink() {
    var text = document.getElementById('reset-link-text').textContent.trim();
    navigator.clipboard.writeText(text).then(function() {
        var label = document.getElementById('copy-label');
        label.textContent = 'Copied!';
        setTimeout(function() { label.textContent = 'Copy Link'; }, 2000);
    });
}
</script>
}
