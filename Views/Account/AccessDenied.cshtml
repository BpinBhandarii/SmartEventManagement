@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <div class="auth-icon" style="background:linear-gradient(135deg,#FF6584,#ff8fa3)">
            <i class="fa-solid fa-ban"></i>
        </div>
        <h2>Access Denied</h2>
        <p class="text-muted">You don't have permission to view this page.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-gradient">
            <i class="fa fa-right-to-bracket me-2"></i>Back to Login
        </a>
    </div>
</div>
