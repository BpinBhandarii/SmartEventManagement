@model SmartEventManagement.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="fa-solid fa-lock-open"></i>
        </div>
        <h2>Set New Password</h2>
        <p class="auth-subtitle">Choose a strong new password for <strong>@Model.Email</strong></p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3">
                <i class="fa fa-circle-exclamation me-2"></i>
                <asp-validation-summary model-only="true" class="d-inline"></asp-validation-summary>
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <div class="input-icon-wrapper">
                    <i class="fa fa-lock input-icon"></i>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="New password (min 6 chars)" autocomplete="new-password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="input-icon-wrapper">
                    <i class="fa fa-lock input-icon"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2">
                <i class="fa fa-check me-2"></i>Reset Password
            </button>
        </form>

        <hr class="my-4" />
        <p class="text-center text-muted small mb-0">
            <a asp-action="Login" class="fw-600"><i class="fa fa-arrow-left me-1"></i>Back to Sign In</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
