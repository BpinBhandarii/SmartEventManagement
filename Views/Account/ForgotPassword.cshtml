@model SmartEventManagement.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="fa-solid fa-key"></i>
        </div>
        <h2>Forgot Password?</h2>
        <p class="auth-subtitle">Enter your email and we'll generate a reset link for you.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3">
                <i class="fa fa-circle-exclamation me-2"></i>
                <asp-validation-summary model-only="true" class="d-inline"></asp-validation-summary>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <div class="input-icon-wrapper">
                    <i class="fa fa-envelope input-icon"></i>
                    <input asp-for="Email" class="form-control" placeholder="Your registered email address" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2">
                <i class="fa fa-paper-plane me-2"></i>Generate Reset Link
            </button>
        </form>

        <hr class="my-4" />
        <p class="text-center text-muted small mb-0">
            Remembered it?
            <a asp-controller="Account" asp-action="Login" class="fw-600">Back to Sign In</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
