@model SmartEventManagement.ViewModels.EventViewModel
@{
    ViewData["Title"] = "Edit Event";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = new[] { "Tech", "Business", "Music", "Arts", "Sports", "Education", "Health", "Food", "Other" };
}

<div class="d-flex">
    <partial name="_OrganiserSidebar" />
    <div class="main-content flex-grow-1">
        <div class="top-bar">
            <button class="btn btn-sm btn-light d-md-none me-2" id="sidebar-toggle"><i class="fa fa-bars"></i></button>
            <h5 class="page-title"><i class="fa fa-pen me-2 text-primary"></i>Edit Event</h5>
        </div>
        <div class="content-area">
            <div class="card p-4" style="max-width:750px;margin:0 auto">
                <div class="alert alert-warning rounded-3 small mb-3">
                    <i class="fa fa-triangle-exclamation me-2"></i>
                    Editing this event will resubmit it for admin approval and notify all registered attendees.
                </div>

                <form asp-action="EditEvent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <asp-validation-summary model-only="true" class="alert alert-danger rounded-3 mb-3"></asp-validation-summary>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Title" class="form-control" placeholder="Event Title" />
                                <label asp-for="Title">Event Title</label>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea asp-for="Description" class="form-control" placeholder="Description" style="height:120px"></textarea>
                                <label asp-for="Description">Description</label>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Location" class="form-control" placeholder="Location" />
                                <label asp-for="Location">Location</label>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="Category" class="form-select">
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                                <label asp-for="Category">Category</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Date" class="form-control" type="date" />
                                <label asp-for="Date">Date</label>
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="Time" class="form-control" type="time" />
                                <label asp-for="Time">Time</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="Capacity" class="form-control" type="number" placeholder="Capacity" />
                                <label asp-for="Capacity">Capacity</label>
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-gradient px-4">
                            <i class="fa fa-floppy-disk me-2"></i>Save Changes
                        </button>
                        <a asp-action="MyEvents" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
